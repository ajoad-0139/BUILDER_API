# ── PostgreSQL (used by Django AND by the docker "db" container) ──
DB_NAME=presto
DB_USER=presto
DB_PASSWORD=presto_pass
DB_HOST=localhost
DB_PORT=5432

# ── Redis (cache + rate limiter) ──
REDIS_URL=redis://127.0.0.1:6379/1
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/2
RATE_LIMIT_ENABLED=True

# ── API cache ──
API_CACHE_ENABLED=True
API_CACHE_TTL=300

# ── S3 storage ──
# settings.py reads these without defaults, so they must exist even when
# S3 is not used. Dummy values are fine for local development.
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_STORAGE_BUCKET_NAME=dummy
AWS_S3_REGION_NAME=us-east-1
